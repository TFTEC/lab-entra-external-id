{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LabExternalId.Web (https://localhost:7100)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/LabExternalId.Web/bin/Debug/net10.0/LabExternalId.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/LabExternalId.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7100;http://localhost:5100"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/LabExternalId.Web/Views"
      }
    }
  ]
}
